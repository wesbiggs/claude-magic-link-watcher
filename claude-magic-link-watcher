#!/usr/bin/env node
// Watches a Proton Mail inbox directly over IMAP IDLE for "Your secure link
// to Claude.ai is here" emails and opens the magic sign-in link in the
// default browser. No dependency on proton-mail-bridge-client's CLI — talks
// to Proton Bridge's local IMAP endpoint directly via imapflow, holding one
// persistent connection so detection is near-instant instead of paying a
// fresh-process-per-lookup cost.
'use strict';

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execFile } = require('child_process');
const { promisify } = require('util');
const { ImapFlow } = require('imapflow');
const { simpleParser } = require('mailparser');

const execFileAsync = promisify(execFile);

const CONFIG_JSON =
  process.env.CONFIG_JSON ||
  '/Users/wes/Library/Application Support/Claude/claude_desktop_config.json';
const STATE_DIR = process.env.STATE_DIR || path.join(os.homedir(), '.claude-magic-link-watcher');
const SEEN_FILE = path.join(STATE_DIR, 'seen-ids.txt');
const SUBJECT_PREFIX = process.env.SUBJECT_PREFIX || 'Your secure link to Claude.ai is here';
const SENDER_SUFFIX = (process.env.SENDER_SUFFIX || '@mail.anthropic.com').toLowerCase();
const FOLDER = process.env.FOLDER || 'INBOX';
const CONFIRM_BEFORE_OPEN = (process.env.CONFIRM_BEFORE_OPEN || 'false') === 'true';
const CONFIRM_TIMEOUT_SECONDS = parseInt(process.env.CONFIRM_TIMEOUT_SECONDS || '60', 10);
const OPEN_DELAY_SECONDS = parseInt(process.env.OPEN_DELAY_SECONDS || '0', 10);
const IDLE_THRESHOLD_SECONDS = parseInt(process.env.IDLE_THRESHOLD_SECONDS || '0', 10);
const RECONNECT_DELAY_MS = 5000;

function sleep(seconds) {
  return new Promise((resolve) => setTimeout(resolve, seconds * 1000));
}

fs.mkdirSync(STATE_DIR, { recursive: true });
if (!fs.existsSync(SEEN_FILE)) fs.writeFileSync(SEEN_FILE, '');

function log(msg) {
  const ts = new Date().toISOString().replace('T', ' ').replace(/\.\d+Z$/, '');
  process.stderr.write(`${ts} [magic-link-watcher] ${msg}\n`);
}

// Loads Proton Bridge IMAP credentials from the existing Claude Desktop MCP
// config rather than duplicating the password into this script.
function loadCredentials() {
  const cfg = JSON.parse(fs.readFileSync(CONFIG_JSON, 'utf8'));
  const env = cfg.mcpServers['proton-mail-bridge'].env;
  return {
    host: env.PROTONMAIL_IMAP_HOST,
    port: parseInt(env.PROTONMAIL_IMAP_PORT, 10),
    secure: env.PROTONMAIL_IMAP_SECURE === 'true',
    user: env.PROTONMAIL_USERNAME,
    pass: env.PROTONMAIL_PASSWORD,
  };
}

// Dedup key is the email's Message-ID header rather than folder::UID — UIDs
// can be reassigned across a UIDVALIDITY change, Message-ID is stable.
function loadSeen() {
  return new Set(fs.readFileSync(SEEN_FILE, 'utf8').split('\n').filter(Boolean));
}

function markSeen(id) {
  fs.appendFileSync(SEEN_FILE, id + '\n');
}

// Optional confirmation gate before opening a link. Off by default. When
// enabled, shows a native dialog; declining or letting it time out (safe
// default button) skips the open.
async function confirmOpen(link) {
  if (!CONFIRM_BEFORE_OPEN) return true;
  const script = `
on run argv
  set theLink to item 1 of argv
  set theTimeout to (item 2 of argv) as integer
  try
    set dlgResult to display dialog "Open this Claude.ai sign-in link?" & return & return & theLink ¬
      with title "Claude Magic Link Watcher" buttons {"Ignore", "Open"} default button "Ignore" ¬
      giving up after theTimeout
    return button returned of dlgResult
  on error
    return "Ignore"
  end try
end run`;
  try {
    const { stdout } = await execFileAsync('osascript', [
      '-e',
      script,
      String(link),
      String(CONFIRM_TIMEOUT_SECONDS),
    ]);
    return stdout.trim() === 'Open';
  } catch (err) {
    log(`Confirmation dialog failed (${err.message}) — treating as declined`);
    return false;
  }
}

// Seconds since the last keyboard/mouse/trackpad event, via IOKit's HID idle
// counter (nanoseconds). Used to skip auto-opening a link when nobody's
// actually at the machine to have triggered the sign-in themselves.
async function getIdleSeconds() {
  const { stdout } = await execFileAsync('ioreg', ['-c', 'IOHIDSystem']);
  const m = stdout.match(/"HIDIdleTime"\s*=\s*(\d+)/);
  return m ? Math.floor(parseInt(m[1], 10) / 1e9) : 0;
}

function extractLink(text) {
  if (!text) return null;
  const m = text.match(/https:\/\/claude\.ai\/magic-link\?[^\s\]\)"'<>]+/);
  return m ? m[0] : null;
}

async function openLink(link) {
  await execFileAsync('open', [link]);
}

// Prime the seen-list with whatever already matches, so old mail already in
// the inbox doesn't get opened when the watcher starts (or reconnects).
async function primeSeen(client) {
  const uids = await client.search({ subject: SUBJECT_PREFIX }, { uid: true });
  if (!uids || uids.length === 0) return;
  for await (const msg of client.fetch(uids, { envelope: true }, { uid: true })) {
    const subject = msg.envelope?.subject || '';
    if (!subject.startsWith(SUBJECT_PREFIX)) continue;
    const messageId = msg.envelope?.messageId;
    if (messageId) markSeen(messageId);
  }
}

// Fetch a sequence range of newly-arrived messages, open the magic link for
// any unseen match, and mark all subject matches (seen or not) as seen so we
// never re-open the same link twice.
async function handleRange(client, seqRange) {
  // Drain the IMAP fetch fully before any processing (parsing, delays,
  // opening) — imapflow warns against running other work mid-fetch-loop, and
  // OPEN_DELAY_SECONDS can pause here for a while.
  const raw = [];
  for await (const msg of client.fetch(seqRange, { source: true })) {
    raw.push(msg);
  }

  const seen = loadSeen();
  for (const msg of raw) {
    let parsed;
    try {
      parsed = await simpleParser(msg.source);
    } catch (err) {
      log(`Failed to parse message seq=${msg.seq}: ${err.message}`);
      continue;
    }

    const subject = parsed.subject || '';
    if (!subject.startsWith(SUBJECT_PREFIX)) continue;

    const messageId = parsed.messageId || `seq:${msg.seq}:${Date.now()}`;
    if (seen.has(messageId)) continue;
    markSeen(messageId);
    seen.add(messageId);

    // Subject alone is spoofable — only act if the sender is actually Anthropic.
    const fromAddr = (parsed.from?.value?.[0]?.address || '').toLowerCase();
    if (!fromAddr.endsWith(SENDER_SUFFIX)) {
      log(`Skipping — subject matched but sender is not ${SENDER_SUFFIX}: ${fromAddr} (${messageId})`);
      continue;
    }

    log(`Matched: ${subject} (${messageId})`);
    const link = extractLink(parsed.text);
    if (!link) {
      log(`No magic link found in body of ${messageId}`);
      continue;
    }

    if (OPEN_DELAY_SECONDS > 0) {
      log(`Waiting ${OPEN_DELAY_SECONDS}s before opening (OPEN_DELAY_SECONDS)...`);
      await sleep(OPEN_DELAY_SECONDS);
    }

    if (IDLE_THRESHOLD_SECONDS > 0) {
      const idleSeconds = await getIdleSeconds();
      if (idleSeconds >= IDLE_THRESHOLD_SECONDS) {
        log(
          `System idle ${idleSeconds}s (>= IDLE_THRESHOLD_SECONDS=${IDLE_THRESHOLD_SECONDS}s) — not opening (${messageId})`,
        );
        continue;
      }
    }

    if (await confirmOpen(link)) {
      log('Opening magic link');
      await openLink(link);
    } else {
      log(`Confirmation declined or timed out — not opening (${messageId})`);
    }
  }
}

async function watchOnce() {
  const creds = loadCredentials();
  const isLocalHost = ['127.0.0.1', 'localhost', '::1'].includes(
    (creds.host || '').trim().toLowerCase(),
  );

  const client = new ImapFlow({
    host: creds.host,
    port: creds.port,
    secure: creds.secure,
    doSTARTTLS: creds.secure ? undefined : true,
    auth: { user: creds.user, pass: creds.pass },
    tls: isLocalHost ? { rejectUnauthorized: false } : undefined,
    logger: false,
    connectionTimeout: 15_000,
    greetingTimeout: 15_000,
  });

  const closed = new Promise((resolve) => {
    client.on('close', () => resolve());
  });
  client.on('error', (err) => log(`IMAP error: ${err.message}`));

  await client.connect();
  log('Proton Bridge IMAP is ready.');
  await client.mailboxOpen(FOLDER);

  log('Priming seen-list from existing mail...');
  await primeSeen(client);

  // Serialize event handling — imapflow can't run overlapping commands, and
  // 'exists' can fire again before a prior handleRange() finishes.
  let queue = Promise.resolve();
  client.on('exists', (data) => {
    const newCount = data.count - data.prevCount;
    if (newCount <= 0) return;
    const range = `${data.prevCount + 1}:${data.count}`;
    log(`notify event received: +${newCount} in ${FOLDER} (seq ${range})`);
    queue = queue
      .then(() => handleRange(client, range))
      .catch((err) => log(`Error handling new mail: ${err.message}`));
  });

  // imapflow enters IDLE automatically after a short period of inactivity
  // (see autoidle() in its source) and emits 'exists' the moment the server
  // pushes new mail — no manual IDLE management needed here.
  log(`Watching ${FOLDER} for Claude.ai magic-link emails...`);
  await closed;
  log('IMAP connection closed — reconnecting...');
}

async function main() {
  log(`Starting. Waiting for Proton Bridge before watching ${FOLDER}...`);
  process.on('SIGINT', () => process.exit(0));
  process.on('SIGTERM', () => process.exit(0));

  let attempt = 0;
  for (;;) {
    try {
      await watchOnce();
      attempt = 0;
    } catch (err) {
      attempt += 1;
      if (attempt === 1 || attempt % 8 === 0) {
        log(`Waiting for Proton Bridge (attempt ${attempt}): ${err.message}`);
      }
    }
    await new Promise((resolve) => setTimeout(resolve, RECONNECT_DELAY_MS));
  }
}

main();
